<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Prime Video</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- Navigation Bar -->

    <nav class="navbar">

        <div class="logo">
            PRIME VIDEO
        </div>

        <div class="nav-links">
            <a href="#">Home</a>
            <a href="#">Movies</a>
            <a href="#">TV Shows</a>
            <a href="#">Sports</a>
        </div>

        <div class="nav-right">
            <input type="text" placeholder="Search">

            <button>Sign In</button>
        </div>

    </nav>


    <!-- Hero Section -->

    <section class="hero">

        <div class="hero-content">

            <h1>Welcome to Prime Video</h1>

            <p>
                Watch popular movies, exclusive series,
                and exciting entertainment all in one place.
            </p>

            <button class="watch-button">
                ▶ Watch Now
            </button>

        </div>

    </section>


    <!-- Popular Movies -->

    <section class="content-section">

        <h2>Popular Movies</h2>

        <div class="movie-row">

            <div class="movie-card">
                <div class="movie-image">MOVIE 1</div>
                <h3>The Last Mission</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">MOVIE 2</div>
                <h3>Dark Horizon</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">MOVIE 3</div>
                <h3>Hidden World</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">MOVIE 4</div>
                <h3>Final Destination</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">MOVIE 5</div>
                <h3>Beyond Earth</h3>
            </div>

        </div>

    </section>


    <!-- Prime Originals -->

    <section class="content-section">

        <h2>Prime Originals</h2>

        <div class="movie-row">

            <div class="movie-card">
                <div class="movie-image">ORIGINAL 1</div>
                <h3>City of Dreams</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">ORIGINAL 2</div>
                <h3>Code Red</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">ORIGINAL 3</div>
                <h3>The Protector</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">ORIGINAL 4</div>
                <h3>Lost Kingdom</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">ORIGINAL 5</div>
                <h3>Night Shift</h3>
            </div>

        </div>

    </section>


    <!-- Footer -->

    <footer>

        <h3>Prime Video</h3>

        <p>
            © 2026 Prime Video Practice Project
        </p>

    </footer>


    <script src="js/script.js"></script>

</body>

</html>
